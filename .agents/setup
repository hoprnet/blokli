#!/usr/bin/env bash
# Prepares an Amp orb for blokli: realizes the Nix dev shell, fetches Cargo
# dependencies, and activates the dev shell in login shells started in the repo.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

nix_profile="$HOME/.nix-profile"
if [[ ! -e "$nix_profile/etc/profile.d/nix.sh" ]]; then
  echo "Nix is not installed; the orb base template is expected to provide it." >&2
  exit 1
fi
# shellcheck disable=SC1091
source "$nix_profile/etc/profile.d/nix.sh"

# Appending to a file whose last line lacks a newline would join it to the first appended line.
ensure_trailing_newline() {
  if [[ -s "$1" && -n "$(tail -c1 "$1")" ]]; then
    echo >>"$1"
  fi
}

# Public binary caches that CI pushes to (see cachix_cache_name in .github/workflows).
configure_caches() {
  local conf="$HOME/.config/nix/nix.conf"
  local marker="# blokli binary caches"
  mkdir -p "$(dirname "$conf")"
  if ! grep -Fqx "$marker" "$conf" 2>/dev/null; then
    ensure_trailing_newline "$conf"
    cat >>"$conf" <<'EOF'
# blokli binary caches
extra-substituters = https://blokli.cachix.org https://hoprnet.cachix.org
extra-trusted-public-keys = blokli.cachix.org-1:SmgBcB1qdG60qBo7wnRFQamn6kfFKgtldkceAztqXlY= hoprnet.cachix.org-1:FzIaDwgsZOy42i2h0qyQ/k9kkggzoeTWmoo/2ehEr90=
EOF
  fi
}

# Keep the dev shell alive across garbage collection and record its environment.
build_dev_shell() {
  mkdir -p "$HOME/.cache/blokli"
  nix print-dev-env --profile "$HOME/.cache/blokli/devshell" >/dev/null
}

fetch_cargo_deps() {
  nix develop --command cargo fetch --locked
}

# Pre-build dependencies so the first `just check` / `just quick` in an orb is incremental.
check_workspace() {
  nix develop --command just check
}

# Login shells started inside the repo get the dev shell environment, so Amp's
# commands and supervised services see the same tools as `nix develop`.
# The block is rewritten on every run so changes to it reach existing orbs.
install_profile_hook() {
  local begin="# >>> blokli Nix development shell >>>"
  local end="# <<< blokli Nix development shell <<<"
  if [[ ! -e "$HOME/.bash_profile" ]]; then
    # Bash reads only the first of these files, so keep loading the one it used before.
    local previous
    for previous in .bash_login .profile; do
      if [[ -e "$HOME/$previous" ]]; then
        echo ". \"\$HOME/$previous\"" >"$HOME/.bash_profile"
        break
      fi
    done
    touch "$HOME/.bash_profile"
  fi
  # sed deletes from an unclosed begin marker to the end of the file, so stop instead.
  if ! awk -v b="$begin" -v e="$end" \
    '$0 == b { if (open) bad = 1; open = 1 } $0 == e { if (!open) bad = 1; open = 0 } END { exit bad || open }' \
    "$HOME/.bash_profile"; then
    echo "$HOME/.bash_profile has unpaired '$begin' / '$end' lines; fix them and rerun." >&2
    return 1
  fi
  sed -i "\|^$begin\$|,\|^$end\$|d" "$HOME/.bash_profile"
  ensure_trailing_newline "$HOME/.bash_profile"
  # Quote the paths for the shell that reads the hook, so no character in them is expanded.
  local root nix
  printf -v root '%q' "$repo_root"
  printf -v nix '%q' "$nix_profile/bin/nix"
  cat >>"$HOME/.bash_profile" <<EOF
$begin
if [[ -z "\${IN_NIX_SHELL:-}" && ( "\$PWD" == $root || "\$PWD" == $root/* ) ]]; then
  # Drop the shell hook's banner and the dirty-tree warning from every command.
  eval "\$($nix print-dev-env --quiet --option warn-dirty false $root)" >/dev/null
fi
$end
EOF
}

# Tell agents in the orb that the dev shell is already active.
install_agent_notes() {
  local notes="$HOME/.config/amp/AGENTS.md"
  local marker="# blokli orb notes"
  mkdir -p "$(dirname "$notes")"
  if ! grep -Fqx "$marker" "$notes" 2>/dev/null; then
    cat >>"$notes" <<'EOF'

# blokli orb notes

- Login shells inside the blokli checkout already load the Nix dev shell (`IN_NIX_SHELL` is set), so run `just`, `cargo`, `forge`, and
  `psql` directly instead of wrapping them in `nix develop -c`.
- After changing `flake.nix`, `flake.lock`, `nix/`, or `rust-toolchain.toml`, new commands pick up the change automatically; the first
  one rebuilds the dev shell. A shell that already has the dev shell loaded, and any shell started from it, keeps the old one.
EOF
  fi
}

step "Configure Nix binary caches" configure_caches
step "Build Nix dev shell" build_dev_shell
step "Fetch Cargo dependencies" fetch_cargo_deps
step "Install login shell hook" install_profile_hook
step "Install agent notes" install_agent_notes
step "Check workspace" check_workspace
