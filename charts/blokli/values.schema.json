{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["database", "config"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of replicas for bloklid deployment"
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "description": "Container image registry"
        },
        "repository": {
          "type": "string",
          "description": "Container image repository"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"],
          "description": "Container image pull policy"
        },
        "tag": {
          "type": "string",
          "description": "Container image tag"
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["postgresql", "sqlite"],
          "description": "Database type"
        },
        "host": {
          "type": "string",
          "description": "PostgreSQL host"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "PostgreSQL port"
        },
        "database": {
          "type": "string",
          "description": "PostgreSQL database name"
        },
        "username": {
          "type": "string",
          "description": "PostgreSQL username"
        },
        "password": {
          "type": "string",
          "description": "PostgreSQL password"
        },
        "index_path": {
          "type": "string",
          "description": "Sqlite database file path"
        },
        "logs_path": {
          "type": "string",
          "description": "Sqlite logs database file path"
        },
        "existingSecret": {
          "type": "string",
          "description": "Name of existing secret containing database credentials"
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of database connections"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "postgresql" } },
            "required": ["type"]
          },
          "then": {
            "if": {
              "properties": {
                "existingSecret": { "type": "string", "minLength": 1 }
              },
              "required": ["existingSecret"]
            },
            "then": {},
            "else": {
              "required": ["host", "port", "database", "username", "password"],
              "properties": {
                "host": { "minLength": 1 },
                "database": { "minLength": 1 },
                "username": { "minLength": 1 },
                "password": { "minLength": 1 }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "sqlite" } },
            "required": ["type"]
          },
          "then": {
            "required": ["index_path", "logs_path"],
            "properties": {
              "index_path": { "minLength": 1 },
              "logs_path": { "minLength": 1 }
            }
          }
        }
      ]
    },
    "config": {
      "type": "object",
      "required": ["network", "rpcUrl", "dataDirectory"],
      "properties": {
        "network": {
          "type": "string",
          "minLength": 1,
          "description": "HOPR network to index"
        },
        "rpcUrl": {
          "type": "string",
          "minLength": 1,
          "format": "uri",
          "description": "Blockchain RPC URL"
        },
        "rpcWsUrl": {
          "type": "string",
          "pattern": "^(wss?://[^/\\s]\\S*)?$",
          "description": "WebSocket RPC URL used for newHeads (empty derives it from rpcUrl)"
        },
        "maxRpcRequestsPerSec": {
          "type": "integer",
          "minimum": 0,
          "description": "Hard cap on RPC requests per second, retries included (0 = unlimited)"
        },
        "maxBlockRange": {
          "type": "integer",
          "minimum": 0,
          "description": "Ceiling for adaptive eth_getLogs block ranges (0 = auto-discover up to 10000)"
        },
        "blockRangeReprobeInterval": {
          "type": "integer",
          "minimum": 0,
          "description": "Consecutive full-range eth_getLogs successes before a larger range is probed again (0 = never)"
        },
        "dataDirectory": {
          "type": "string",
          "minLength": 1,
          "description": "Data directory path"
        },
        "indexer": {
          "type": "object",
          "properties": {
            "fastSync": {
              "type": "boolean",
              "description": "Enable fast sync mode"
            },
            "enableLogsSnapshot": {
              "type": "boolean",
              "description": "Enable logs snapshot feature"
            },
            "logsSnapshotUrl": {
              "type": "string",
              "description": "URL for logs snapshot download"
            },
            "logsSnapshotSha256": {
              "type": "string",
              "description": "Expected SHA-256 hex digest of the logs snapshot archive",
              "pattern": "^([0-9a-fA-F]{64})?$"
            },
            "headTracking": {
              "type": "object",
              "properties": {
                "headSubscription": {
                  "oneOf": [
                    { "type": "boolean" },
                    { "type": "string", "maxLength": 0 }
                  ],
                  "description": "Use newHeads over WebSocket when the RPC endpoint supports it (empty uses the daemon default)"
                },
                "headPollInterval": {
                  "type": "string",
                  "pattern": "^(\\d+(\\.\\d+)?(nsec|ns|usec|us|msec|ms|seconds|second|sec|s|minutes|minute|min|m|hours|hour|hr|h|days|day|d|weeks|week|w|months|month|M|years|year|y)\\s*)*$",
                  "description": "Polling interval used when newHeads is unavailable or disabled (empty uses the daemon default)"
                }
              }
            },
            "confirmation": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["", "depth", "safe_or_depth", "safe", "finalized"],
                  "description": "Confirmation rule (empty uses depth on all networks)"
                },
                "depth": {
                  "oneOf": [
                    { "type": "integer", "minimum": 1, "maximum": 100 },
                    { "type": "string", "maxLength": 0 }
                  ],
                  "description": "Blocks behind latest used by depth-based modes (empty uses the network default)"
                },
                "maxSafeGap": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9223372036854775807
                    },
                    { "type": "string", "maxLength": 0 }
                  ],
                  "description": "Latest-to-safe gap at or above which the Fast Confirmation Rule counts as degraded (empty uses the daemon default)"
                },
                "verifyFinalized": {
                  "oneOf": [
                    { "type": "boolean" },
                    { "type": "string", "maxLength": 0 }
                  ],
                  "description": "Re-check indexed blocks against the canonical chain once they become final (empty uses the daemon default)"
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "enableLogsSnapshot": { "const": true } },
                "required": ["enableLogsSnapshot"]
              },
              "then": {
                "required": ["logsSnapshotSha256"],
                "properties": { "logsSnapshotSha256": { "minLength": 64 } }
              }
            },
            {
              "if": {
                "properties": {
                  "logsSnapshotUrl": { "type": "string", "pattern": "\\S" }
                },
                "required": ["logsSnapshotUrl"]
              },
              "then": {
                "required": ["logsSnapshotSha256"],
                "properties": { "logsSnapshotSha256": { "minLength": 64 } }
              }
            }
          ]
        },
        "logging": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "description": "Rust log level configuration"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
          "description": "Service type"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Service port"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable ingress"
        },
        "className": {
          "type": "string",
          "description": "Ingress class name"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": {
                "type": "string",
                "format": "hostname"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable persistence"
        },
        "storageClass": {
          "type": "string",
          "description": "Storage class"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+[KMGT]i$",
          "description": "PVC size"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
